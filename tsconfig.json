{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["resources/js/*"],
      "@particle-academy/react-fancy": ["../react-fancy/src"],
      "@particle-academy/fancy-echarts": ["../fancy-echarts/src"],
      "@particle-academy/fancy-code": ["../fancy-code/src"],
      "@particle-academy/fancy-sheets": ["../fancy-sheets/src"]
    }
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
