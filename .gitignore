*.log
.DS_Store
# Every env file EXCEPT the committed example. The list used to name three
# variants individually, so any other one — .env.local, .env.staging, a
# throwaway .env.<something> made while debugging — was untracked-but-not-
# ignored, i.e. one `git add` away from committing real credentials.
.env*
!.env.example
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.cursor
/.vscode
/.zed
/.rnd
/.claude
/.mcp.json
/auth.json
/react-demo
/node_modules
/bootstrap/ssr
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
packages/*/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# SQLite databases — never commit local OR prod data (the app defaults to
# DB_CONNECTION=sqlite). Keeps test/seed/local rows from ever shipping.
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal
/emoji-test.txt
/scripts/
.bots/state/
.ai/handoff/
.ai/checkpoints/
.ai/bots/
.worktrees/
/storage/app/manifest.ts

# Local Cursor MCP config — can hold API tokens; never commit
.cursor/mcp.json
