# The dependency graph has a peerOptional conflict: @particle-academy/fancy-screens
# declares zustand ^5 as an optional peer, while @xyflow/react (via fancy-flow)
# hard-pins zustand ^4. npm 7+'s strict resolver rejects this on `npm ci` /
# `npm install`, which breaks CI + Forge deploys. zustand 4 satisfies every
# package that actually USES the store, so accept the resolution.
legacy-peer-deps=true
