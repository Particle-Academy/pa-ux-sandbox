{
  "schemaVersion": 1,
  "name": "particle-academy/fancy-flow-nodes",
  "kind": "@particle-academy/git_pr_open",
  "aliases": [
    "git_pr_open"
  ],
  "configVersion": 1,
  "title": "Open Pull Request",
  "category": "io",
  "description": "Open a pull request from one branch into another, on GitHub, GitLab or Bitbucket.",
  "ui": [
    "ui"
  ],
  "runtimes": {
    "ts": {
      "files": [
        "js"
      ],
      "engine": ">=0.30.0"
    },
    "php": {
      "files": [
        "php"
      ],
      "engine": ">=0.9.0"
    }
  },
  "capabilities": {
    "gitProvider": "required"
  },
  "fancyDependencies": [
    {
      "package": "fancy-git",
      "npm": "@particle-academy/fancy-git",
      "composer": "particle-academy/fancy-git",
      "reason": "the provider contract this node acts through — the host hands it over as a ProviderRegistry",
      "requirement": "required"
    },
    {
      "package": "fancy-git-github",
      "npm": "@particle-academy/fancy-git-github",
      "composer": "particle-academy/fancy-git-github",
      "reason": "one adapter per host you target — swap for fancy-git-gitlab or fancy-git-bitbucket",
      "requirement": "optional"
    }
  ],
  "fixtures": "nodes/git-pr-open/fixtures/git-pr-open.json",
  "sideEffects": "unsafe-to-replay"
}
