APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSockets) — powers the live "active users" feed + fancy-query
# Echo cache-invalidation. Generate credentials with `php artisan reverb:install`.
#
# REVERB_HOST/PORT/SCHEME are the PUBLIC endpoint clients connect to (and that the
# app publishes through). REVERB_SERVER_HOST/PORT are the daemon's local bind that
# `php artisan reverb:start` listens on; nginx proxies the public wss to it.
#
# These defaults are LOCAL dev (plaintext Reverb on localhost:8080). In PRODUCTION
# run the daemon behind an nginx subdomain that terminates wss:443 and proxies to
# the daemon, then set the PUBLIC values — the VITE_* below derive from them, so
# the browser client gets 443/https automatically (and `npm run build` bakes them
# in, so the deploy must build with these set):
#   REVERB_HOST=ws.ui.particle.academy   REVERB_PORT=443   REVERB_SCHEME=https
#   REVERB_SERVER_HOST=0.0.0.0           REVERB_SERVER_PORT=8080
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Inertia SSR — server-renders page CONTENT (not just SEO meta) into the first
# byte, so crawlers/agents see the real page. The React #418 hydration mismatches
# are fixed: SSR/client icon registration now matches (ssr.tsx), react-fancy's
# lucide auto-fallback is SSR-deterministic (>=4.7.1), and no <a> is nested in a
# <Link> (the un-nesting the browser does broke hydration). Locally it gracefully
# falls back to client render when no SSR daemon is running.
#   PROD requires: (1) the deploy builds the SSR bundle (`npm run build` already
#   runs `vite build --ssr`); (2) a persistent `php artisan inertia:start-ssr`
#   daemon (port 13733); (3) this = true in the Forge env. RELIABILITY: the PHP→
#   daemon SSR call is bounded by App\Ssr\TimeoutHttpGateway (defaults below) so a
#   hung daemon FAST-FAILS to client render instead of pinning an FPM worker for
#   30s (which once exhausted the pool); still give PHP-FPM some headroom.
INERTIA_SSR_ENABLED=true
# SSR HTTP timeouts in seconds (a render is normally <1s). Lower = a hung daemon
# frees the FPM worker sooner; higher = more tolerant of slow cold renders.
INERTIA_SSR_TIMEOUT=5
INERTIA_SSR_CONNECT_TIMEOUT=2

# Docs TUI render service — the localhost Node process (`npm run tui-service`)
# that renders the real fancy-tui Ink app for /fancy-tui and browses the real
# MCP. Leave unset and the page degrades to the HTML docs. The service binds
# 127.0.0.1; point this at it, and set TUI_MCP_URL (in the service's own env) at
# this app's /mcp so the terminal browses the live registry.
#   TUI_SERVICE_URL=http://127.0.0.1:8790
# TUI_SERVICE_URL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Holy Sheet AI agent demo (Laravel AI SDK)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# GitHub OAuth (Fancy UI Showcase login) — create an OAuth App at
# https://github.com/settings/applications/new with callback
# http://<host>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# GitHub PAT for the leaderboard + showcase scanning. Read-only, public repos.
#
# WITHOUT IT the leaderboard falls back to a votes-only snapshot — no stars, no
# merged PRs, no issues. That drops every contributor who only ever starred a
# repo, which in practice is most of the board (12 of 15 rows when this was last
# measured). `showcase:refresh-leaderboard` prints per-section counts and refuses
# to overwrite a healthy snapshot with an empty one, so check its output.
#
# It has to satisfy, for every Particle-Academy/* repo:
#   GET /repos/{repo}              — stargazers_count
#   GET /repos/{repo}/stargazers   — with Accept: application/vnd.github.star+json
#   GET /repos/{repo}/pulls, /issues
#
# A classic PAT with `public_repo` is the low-maintenance choice. A fine-grained
# PAT also works (Metadata: Read-only, all repositories) but EXPIRES in <= 1 year
# and expires SILENTLY: collection just starts returning empty and the board
# quietly shrinks. If contributors vanish, suspect this first.
GITHUB_API_TOKEN=
