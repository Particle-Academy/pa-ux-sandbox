APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSockets) — powers the live "active users" feed.
# Generate app credentials with `php artisan reverb:install` or set your own.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Inertia SSR — server-renders page CONTENT (not just SEO meta) into the first
# byte, so crawlers/agents see the real page. The React #418 hydration mismatches
# are fixed: SSR/client icon registration now matches (ssr.tsx), react-fancy's
# lucide auto-fallback is SSR-deterministic (>=4.7.1), and no <a> is nested in a
# <Link> (the un-nesting the browser does broke hydration). Locally it gracefully
# falls back to client render when no SSR daemon is running.
#   PROD requires: (1) the deploy builds the SSR bundle (`npm run build` already
#   runs `vite build --ssr`); (2) a persistent `php artisan inertia:start-ssr`
#   daemon (port 13733); (3) this = true in the Forge env. RELIABILITY: a hung
#   daemon can exhaust PHP-FPM workers (each in-flight render holds one) — keep a
#   short SSR HTTP timeout + FPM headroom so a slow daemon fast-fails to client
#   render instead of cascading. See .ai/memory ssr-blocked notes.
INERTIA_SSR_ENABLED=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Holy Sheet AI agent demo (Laravel AI SDK)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# GitHub OAuth (Fancy UI Showcase login) — create an OAuth App at
# https://github.com/settings/applications/new with callback
# http://<host>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# GitHub PAT for leaderboard + showcase scanning (optional in Phase 1).
# Fine-grained, public-repo metadata + read-only contents on Particle-Academy/*.
GITHUB_API_TOKEN=
