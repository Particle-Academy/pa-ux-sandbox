{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/ai": "^0.6.7",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.7",
        "laravel/reverb": "^1.10",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^3.0",
        "particle-academy/dark-slide": ">=0.8.0 <2.0",
        "particle-academy/fancy-cms": ">=0.3.0 <2.0",
        "particle-academy/fancy-flow-php": "0.51.0",
        "particle-academy/fancy-heuristics": ">=0.4.0 <2.0",
        "particle-academy/fancy-mlm": ">=0.3.0 <2.0",
        "particle-academy/fancy-seo": ">=0.5.0 <2.0",
        "particle-academy/fancy-x-files": ">=0.2.0 <2.0",
        "particle-academy/holy-sheet": "^2.0.1",
        "particle-academy/laravel-catalog": ">=0.13.0 <2.0",
        "particle-academy/laravel-courses": ">=0.2.0 <2.0",
        "particle-academy/laravel-fms": ">=0.11.0 <2.0",
        "particle-academy/laravel-fun-lab": ">=0.6.0 <2.0",
        "particle-academy/last-word": ">=0.3.0 <2.0",
        "spatie/browsershot": "^5.4",
        "stripe/stripe-php": "^17.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "particle-academy/fancy-git": ">=0.2 <2.0",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "FancyFlow\\Nodes\\Connector\\": "resources/flow-nodes/_connector/php/",
            "FancyFlow\\Nodes\\Stripe\\": "resources/flow-nodes/_stripe/php/",
            "FancyFlow\\Nodes\\Resend\\": "resources/flow-nodes/_resend/php/",
            "FancyFlow\\Nodes\\Telegram\\": "resources/flow-nodes/_telegram/php/",
            "FancyFlow\\Nodes\\StripePaymentIntent\\": "resources/flow-nodes/stripe-payment-intent/php/",
            "FancyFlow\\Nodes\\StripeWebhookTrigger\\": "resources/flow-nodes/stripe-webhook-trigger/php/",
            "FancyFlow\\Nodes\\ResendEmailSend\\": "resources/flow-nodes/resend-email-send/php/",
            "FancyFlow\\Nodes\\TelegramUpdatesTrigger\\": "resources/flow-nodes/telegram-updates-trigger/php/",
            "FancyFlow\\Nodes\\UiEffect\\": "resources/flow-nodes/ui-effect/php/",
            "FancyFlow\\Nodes\\GitPrOpen\\": "resources/flow-nodes/git-pr-open/php/",
            "FancyFlow\\Nodes\\GitPrList\\": "resources/flow-nodes/git-pr-list/php/",
            "FancyFlow\\Nodes\\GitPrGet\\": "resources/flow-nodes/git-pr-get/php/",
            "FancyFlow\\Nodes\\GitPrChecks\\": "resources/flow-nodes/git-pr-checks/php/",
            "FancyFlow\\Nodes\\GitPrCompare\\": "resources/flow-nodes/git-pr-compare/php/",
            "FancyFlow\\Nodes\\GitRepo\\": "resources/flow-nodes/git-repo/php/",
            "FancyFlow\\Nodes\\GitStatus\\": "resources/flow-nodes/git-status/php/",
            "FancyFlow\\Nodes\\GitLog\\": "resources/flow-nodes/git-log/php/",
            "FancyFlow\\Nodes\\GitBranches\\": "resources/flow-nodes/git-branches/php/",
            "FancyFlow\\Nodes\\GitDiff\\": "resources/flow-nodes/git-diff/php/",
            "FancyFlow\\Nodes\\GitCheckout\\": "resources/flow-nodes/git-checkout/php/",
            "FancyFlow\\Nodes\\GitPush\\": "resources/flow-nodes/git-push/php/",
            "FancyFlow\\Nodes\\GitPull\\": "resources/flow-nodes/git-pull/php/",
            "FancyFlow\\Nodes\\LlmInput\\": "resources/flow-nodes/llm-input/php/",
            "FancyFlow\\Nodes\\LlmScreen\\": "resources/flow-nodes/llm-screen/php/",
            "FancyFlow\\Nodes\\DeepResearch\\": "resources/flow-nodes/deep-research/php/",
            "FancyFlow\\Nodes\\GitIssueOpen\\": "resources/flow-nodes/git-issue-open/php/",
            "FancyFlow\\Nodes\\GitIssueGet\\": "resources/flow-nodes/git-issue-get/php/",
            "FancyFlow\\Nodes\\GitIssueList\\": "resources/flow-nodes/git-issue-list/php/",
            "FancyFlow\\Nodes\\GitIssueUpdate\\": "resources/flow-nodes/git-issue-update/php/",
            "FancyFlow\\Nodes\\GitIssueComment\\": "resources/flow-nodes/git-issue-comment/php/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
